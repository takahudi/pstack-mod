{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\" codex",
            "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT/hooks/session-start.mjs\" codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
